# CinemaGraphy — example environment (copy to .env or Cloudflare Variables)
# Docs: /guide on your deployed site

# --- Core ---
TMDB_API_KEY=
LOG_LEVEL=info
DEV_MODE=false
# Public addon origin (TMDB image rewrite / landing fallback). Production:
PUBLIC_BASE_URL=https://cmplugin.ir

# --- Iranian stream providers (empty BASEURL = provider off) ---
F2MEDIA_BASEURL=https://www.film2med.top
ENABLE_F2_TURKISH=1

CINAMATIC_BASEURL=
ASLMOVIEZ_BASEURL=
SERIALBLOG_BASEURL=
DONYAYESERIAL_BASEURL=

ANIMEX_BASEURL=https://animex.click
ENABLE_ANIMEX_CATALOG=1

# VIP — prefer personal /configure only; do NOT put cookies on a public Worker
# DIGIMOVIE_BASEURL=https://digimoviez.com
# DIGIMOVIE_COOKIE=
# AVAMOVIE_BASEURL=https://avamovie.shop
# AVAMOVIE_COOKIE=

# ENABLE_NAMAKADE=0
# NAMAKADE_BASEURL=

# --- External catalogs (get URLs from each project's /configure) ---
# 101: https://config.101catalogs.xyz/  → prefer meta/off so CinemaGraphy FA meta stays
CATALOG101_MANIFEST_URL=https://api.101catalogs.xyz/t0-free/lists/000vBfBg4q4l4s4y4k4u4o5m504w5PBtBs0x044r4m4t4z4n4v4p515n4x5QB0/meta/off/manifest.json

# Anime catalogs: https://1fe84bc728af-stremio-anime-catalogs.baby-beamup.club/configure
CATALOG_ANIME_MANIFEST_URL=https://1fe84bc728af-stremio-anime-catalogs.baby-beamup.club/manifest.json

# IPTV / satellite: https://iptvbridge.vercel.app/configure
CATALOG_IPTVBRIDGE_MANIFEST_URL=https://iptvbridge.vercel.app/manifest.json

# Torrent Meteor (optional): https://meteorfortheweebs.midnightignite.me/stremio/configure
# TORRENT_METEOR_MANIFEST_URL=

# Subtitles (if used by your build)
SUBSOURCE_MANIFEST_URL=

# AIO / extra (optional)
# CATALOG_AIO_MANIFEST_URL=
# EXTERNAL_CATALOG_MANIFEST_URLS=

# --- Proxy (generic; TMDB poster proxy is separate on /api/tmdb-image/) ---
PROXY_ENABLE=true
PROXY_PATH=proxy
# PROXY_ALLOWED_URLS=metahub.space,imdb.com,strem.io,tmdb.org

# Node / VPS only
# PORT=7000
# ADMIN_PASSWORD=
# RATE_LIMIT_ENABLED=0
